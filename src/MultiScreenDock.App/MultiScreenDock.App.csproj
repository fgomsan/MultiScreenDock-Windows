    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MultiScreenDock</AssemblyName>
    <RootNamespace>MultiScreenDock.App</RootNamespace>
    <Version>1.5.0</Version>
    <Company>Fernando Gómez Sancha</Company>
