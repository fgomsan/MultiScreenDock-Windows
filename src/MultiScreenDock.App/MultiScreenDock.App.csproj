    <Copyright>© 2026 Fernando Gómez Sancha</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MultiScreenDock.Core\MultiScreenDock.Core.csproj" />
  </ItemGroup>
</Project>
